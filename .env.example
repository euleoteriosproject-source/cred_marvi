# Override opcional da URL pública, sem barra final. Na produção Netlify, URL e CONTEXT são detectadas automaticamente.
SITE_URL=

# Conteúdo da meta tag google-site-verification fornecida pelo Google Search Console.
GOOGLE_SITE_VERIFICATION=

# Somente dígitos com código do país e DDD. Quando ausente ou inválido, usa o canal público de fallback.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Canal público opcional. Quando ausente, não é exibido.
NEXT_PUBLIC_CONTACT_EMAIL=
