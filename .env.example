# URL pública confirmada, sem barra final. Omitir enquanto não houver domínio oficial.
SITE_URL=

# Somente dígitos com código do país e DDD. Quando ausente, CTAs usam /contato.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Canal público opcional. Quando ausente, não é exibido.
NEXT_PUBLIC_CONTACT_EMAIL=

# Endpoint público da Atrium API, http/https e sem query ou fragment.
NEXT_PUBLIC_ATRIUM_API_URL=

# Public key do tenant Atrium. Configurar localmente; nunca registrar em logs.
NEXT_PUBLIC_ATRIUM_PUBLIC_KEY=
